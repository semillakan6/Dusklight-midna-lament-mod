list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TOOLCHAIN_ROOT)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT TOOLCHAIN_ROOT)
  message(FATAL_ERROR "Pass -DTOOLCHAIN_ROOT=<portable LLVM/SDK root>")
endif()
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/llvm/bin/clang-cl.exe")
set(CMAKE_LINKER "${TOOLCHAIN_ROOT}/llvm/bin/lld-link.exe")
set(CMAKE_AR "${TOOLCHAIN_ROOT}/llvm/bin/llvm-lib.exe")
set(CMAKE_RC_COMPILER "${TOOLCHAIN_ROOT}/llvm/bin/llvm-rc.exe")
set(CMAKE_MT "${TOOLCHAIN_ROOT}/llvm/bin/llvm-mt.exe")
set(CMAKE_CXX_FLAGS_INIT "/winsysroot:\"${TOOLCHAIN_ROOT}/sysroot\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/winsysroot:\"${TOOLCHAIN_ROOT}/sysroot\" /MANIFEST:NO")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "/winsysroot:\"${TOOLCHAIN_ROOT}/sysroot\" /MANIFEST:NO")

file(GLOB _crt_dirs "${TOOLCHAIN_ROOT}/sysroot/VC/Tools/MSVC/*")
list(GET _crt_dirs 0 _crt)
file(GLOB _sdk_dirs "${TOOLCHAIN_ROOT}/sysroot/Windows Kits/10/Include/*")
list(GET _sdk_dirs 0 _sdk)
set(CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES "${_crt}/include;${_sdk}/ucrt;${_sdk}/shared;${_sdk}/um")
